{
  "name": "goho",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm fmt:check && turbo run lint tsc test:unit",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules",
    "dev": "turbo run dev --ui=tui",
    "lint": "turbo run lint",
    "fmt": "oxfmt --config ./tools/oxfmt-config/src/base.json .",
    "fmt:check": "oxfmt --check --config ./tools/oxfmt-config/src/base.json .",
    "fmt:android": "cd programs/goho-android && ./gradlew :app:ktfmtFormat",
    "fmt:check:android": "cd programs/goho-android && ./gradlew :app:ktfmtCheck",
    "tsc": "turbo run tsc",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@goho/tool-oxfmt-config": "workspace:*",
    "oxfmt": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^12.3.4"
  },
  "packageManager": "pnpm@12.3.4"
}

{
  "name": "@goho/program-receipts",
  "version": "0.0.0",
  "private": true,
  "description": "Processes receipts from Google services.",
  "bin": {
    "receipts": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "clean": "rimraf node_modules dist build .turbo coverage",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "fmt": "oxfmt --config ../../tools/oxfmt-config/src/base.json .",
    "fmt:check": "oxfmt --check --config ../../tools/oxfmt-config/src/base.json .",
    "lint": "oxlint .",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/ai-openai": "catalog:",
    "@effect/platform-node": "catalog:",
    "@goho/lib-core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@goho/tool-oxfmt-config": "workspace:*",
    "@goho/tool-oxlint-config": "workspace:*",
    "@goho/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}

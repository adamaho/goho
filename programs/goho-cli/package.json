{
  "name": "@goho/goho-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line interface for Goho.",
  "bin": {
    "goho": "./src/main.ts"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "clean": "rimraf node_modules dist build .turbo coverage",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "lint": "oxlint .",
    "tsc": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@goho/goho-server-client": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "catalog:",
    "@adamaho/nopeus-oxlint-plugin": "catalog:",
    "@goho/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@goho/raw-csv-importer",
  "version": "0.0.0",
  "private": true,
  "description": "Disposable importer for historical RAW receipt CSV exports.",
  "bin": {
    "goho-import-raw-csv": "./src/main.ts"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "clean": "rimraf node_modules dist build .turbo coverage",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "lint": "oxlint .",
    "tsc": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@goho/core": "workspace:*",
    "@goho/goho-api": "workspace:*",
    "csv-parse": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "catalog:",
    "@adamaho/nopeus-oxlint-plugin": "catalog:",
    "@effect/vitest": "catalog:",
    "@goho/goho-server": "workspace:*",
    "@goho/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

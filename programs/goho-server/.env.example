GOHO_SERVER_PORT=3000

GOHO_UPLOADS_DIRECTORY=.data/receipt-uploads
# A nonempty placeholder lets the server start without an OpenAI account.
# Replace it with a real key only to process uploaded receipt images.
OPENAI_API_KEY=not-configured
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgresql://goho:goho@127.0.0.1:5432/goho

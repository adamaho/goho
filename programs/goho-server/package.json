{
  "name": "@goho/goho-server",
  "version": "0.0.0",
  "private": true,
  "description": "Receipt processing HTTP server for Goho.",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "clean": "rimraf node_modules dist build .turbo coverage",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "lint": "oxlint .",
    "tsc": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "openapi:generate": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check",
    "db:migrate": "node --env-file-if-exists=.env src/database/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "test:integration": "vitest run --project integration",
    "image": "node scripts/build-image.ts",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "@effect/ai-openai": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@goho/core": "workspace:*",
    "@goho/goho-api": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "catalog:",
    "@adamaho/nopeus-oxlint-plugin": "catalog:",
    "@effect/vitest": "catalog:",
    "@goho/goho-server-client": "workspace:*",
    "@goho/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

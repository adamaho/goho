{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "passThroughEnv": ["GITHUB_SHA", "GOHO_IMAGE_REGISTRY"],
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["GITHUB_SHA", "GOHO_IMAGE_REGISTRY", "GOHO_DEPLOY_HOST"],
      "outputs": []
    }
  }
}

{
  "name": "@goho/goho-server-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed Effect client for the Goho server API.",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./receipt-uploads": "./src/receipt-uploads.ts",
    "./receipts": "./src/receipts.ts",
    "./response": "./src/response.ts"
  },
  "scripts": {

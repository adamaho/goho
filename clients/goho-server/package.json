    "lint": "oxlint .",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@goho/goho-api": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "catalog:",
    "@adamaho/nopeus-oxlint-plugin": "catalog:",
    "@goho/tool-oxfmt-config": "workspace:*",
    "@goho/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}

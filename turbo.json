{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "tsc": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit", "^lint"],
      "outputs": []
    },
    "fmt": {
      "outputs": []
    },
    "fmt:check": {
      "outputs": []
    },
    "openapi:check": {
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "infra:up": {
      "cache": false,
      "env": ["COMPOSE_PROJECT_NAME", "GOHO_POSTGRES_PORT"],
      "outputs": []
    },
    "infra:down": {
      "cache": false,
      "outputs": []
    },
    "infra:logs": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "infra:reset": {
      "cache": false,
      "outputs": []
    },
    "db:create": {
      "cache": false,
      "dependsOn": ["@goho/infra-local#infra:up"],
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": ["@goho/infra-local#infra:up"],
      "env": ["DATABASE_URL"],
      "outputs": []
    },
    "db:push": {
      "cache": false,
      "dependsOn": ["db:create"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["transit" /* "db:push" */]
    },
    "@goho/goho-server#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["transit", "db:migrate"]
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": ["GITHUB_SHA", "GOHO_IMAGE_REGISTRY", "GOHO_DEPLOY_HOST"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "env": ["TEST_DATABASE_URL"],
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:component": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}

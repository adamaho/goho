{
  "name": "@goho/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared core logic for Goho programs.",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rimraf node_modules dist build .turbo coverage",
    "lint": "oxlint .",
    "tsc": "tsc --noEmit",
    "test:integration": "vitest run test/*.integration.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "catalog:",
    "@adamaho/nopeus-oxlint-plugin": "catalog:",
    "@effect/vitest": "catalog:",
    "@goho/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

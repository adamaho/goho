#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
SECONDS=0
readonly node_version="24.15.0"
readonly pnpm_version="12.3.4"
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

: "${NODE_AUTH_TOKEN:?Set the Amp project NODE_AUTH_TOKEN secret to a token with read:packages access to @adamaho packages.}"
export NODE_AUTH_TOKEN

if ! docker compose version >/dev/null 2>&1; then
  echo "Installing the Docker Compose plugin..."
  sudo apt-get update
  sudo apt-get install -y docker-compose-plugin
fi

installed_pnpm_version=""
if [[ -x "$PNPM_HOME/bin/pnpm" ]]; then
  installed_pnpm_version="$(cd "$HOME" && "$PNPM_HOME/bin/pnpm" --version 2>/dev/null || true)"
fi
if [[ "$installed_pnpm_version" != "$pnpm_version" ]]; then
  echo "Installing pnpm $pnpm_version..."
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl --fail --location --retry 3 https://get.pnpm.io/install.sh -o "$installer"
  PNPM_VERSION="$pnpm_version" ENV="$HOME/.bashrc" SHELL=/bin/bash sh "$installer"
  rm -f "$installer"
  trap - EXIT
fi

if [[ ! -x "$PNPM_HOME/bin/node" ]] || [[ "$("$PNPM_HOME/bin/node" --version)" != "v$node_version" ]]; then
  echo "Installing Node.js $node_version through pnpm (${SECONDS}s elapsed)..."
  "$PNPM_HOME/bin/pnpm" runtime set node "$node_version" --global
fi

mkdir -p "$HOME/.config/amp"
cat > "$HOME/.config/amp/goho-env.bash" <<EOF
export PNPM_HOME="$PNPM_HOME"
case ":\$PATH:" in
  *":\$PNPM_HOME/bin:"*) ;;
  *) export PATH="\$PNPM_HOME/bin:\$PATH" ;;
esac
EOF
marker="# Goho orb Node.js and pnpm environment"
touch "$HOME/.bash_profile"
sed -i \
  -e '\|^# Goho orb development environment$|d' \
  -e '\|^# Goho orb Node.js and pnpm environment$|d' \
  -e '\|^source "\$HOME/.config/amp/goho-env.bash"$|d' \
  "$HOME/.bash_profile"
printf '\n%s\n%s\n' "$marker" 'source "$HOME/.config/amp/goho-env.bash"' >> "$HOME/.bash_profile"

echo "Using Node.js $(node --version) and pnpm $(pnpm --version)."
echo "Installing locked workspace dependencies (${SECONDS}s elapsed)..."
# GitHub Packages requires authentication even for public packages. pnpm only
# expands token references in trusted user auth files, so use a temporary one
# and leave both the repository and the user's normal npm configuration intact.
npm_user_config="$(mktemp)"
trap 'rm -f "$npm_user_config"' EXIT
chmod 0600 "$npm_user_config"
printf '%s\n' '//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}' > "$npm_user_config"
NPM_CONFIG_USERCONFIG="$npm_user_config" pnpm install --frozen-lockfile
rm -f "$npm_user_config"
trap - EXIT

for program in goho-server goho-cli; do
  env_file="programs/$program/.env"
  if [[ ! -f "$env_file" ]]; then
    cp -- "$env_file.example" "$env_file"
  fi
done

echo "Orb setup completed in ${SECONDS}s."

[Unit]
Description=Goho deployment PostgreSQL
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/etc/goho
ExecStart=/usr/bin/docker compose --env-file /etc/goho/postgres.env -f /etc/goho/compose.yml up -d --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose --env-file /etc/goho/postgres.env -f /etc/goho/compose.yml stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

[Unit]
Description=Process Goho receipts
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=adam
Group=adam
WorkingDirectory=/home/adam/github.com/adamaho/goho
Environment=HOME=/home/adam
EnvironmentFile=/etc/goho/receipts.env
RuntimeDirectory=goho
RuntimeDirectoryMode=0750
ExecStart=/home/adam/github.com/adamaho/goho/infra/systemd/goho-receipts/run.sh
TimeoutStartSec=infinity

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

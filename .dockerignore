# turbo prune selects what goho-server needs; this keeps local-only and
# secret files out of the build context entirely.
**/node_modules
**/.turbo
**/.data
**/.env
**/.env.*
!**/.env.example
**/.secrets
**/.credentials
**/.aws
**/.ssh
**/.gnupg
**/.azure
**/.config/gcloud
**/.config/gh
**/.docker
**/.kube
**/.npmrc
**/.netrc
**/.git-credentials
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/id_ecdsa_sk
**/id_ed25519_sk
**/dist
**/build
**/coverage
**/*.log
.git
programs/goho-android
